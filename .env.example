# AI Generation (provider-agnostic)
#
# Leave all of these unset to keep template-only mode.
#
# OPENPAGE_LLM_PROVIDER: "openai" for any OpenAI-compatible /chat/completions
# endpoint (OmniRoute, OpenRouter, vLLM, LM Studio, ...) or "gemini" for Google.
# When omitted, "openai" is assumed as soon as a base URL or a key is present.
OPENPAGE_LLM_PROVIDER=openai

# Base URL including the version segment. Examples:
#   https://omniroute.example.com/v1
#   https://openrouter.ai/api/v1
OPENPAGE_LLM_BASE_URL=

# Server-side key. Never exposed to the browser: the client only talks to
# /api/generate.
OPENPAGE_LLM_API_KEY=

# Model id sent to the provider. The UI can override it per browser.
OPENPAGE_LLM_MODEL=

# Gemini only (OPENPAGE_LLM_PROVIDER=gemini). Used when OPENPAGE_LLM_API_KEY
# is not set.
GEMINI_API_KEY=

# Image Search (Pexels)
# Required for the /api/pexels image search endpoint
PEXELS_API_KEY=

# One-Click Deploy (Vercel)
# Required for the /api/deploy endpoint
VERCEL_DEPLOY_TOKEN=
VERCEL_TEAM_ID=

# Deploy Security
# Secret key to authorize deploy requests
OPENPAGE_DEPLOY_KEY=
# Comma-separated list of allowed CORS origins
OPENPAGE_ALLOWED_ORIGINS=https://openpage-phi.vercel.app
